{
  "name": "@match-engine/core",
  "version": "2.0.0",
  "description": "Small deterministic football match simulator for web applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "distribution": "npx --yes tsx tests/distribution.ts",
    "demo": "npm run build && node scripts/demo.cjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "coverage"
  },
  "keywords": [
    "football",
    "simulation",
    "match-engine",
    "sports-ai"
  ],
  "license": "MIT",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mariani5472/engine_futebol.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/Mariani5472/engine_futebol/issues"
  },
  "homepage": "https://github.com/Mariani5472/engine_futebol#readme"
}
