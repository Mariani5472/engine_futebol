{
  "name": "match-engine",
  "version": "0.1.0",
  "description": "Football match simulation engine — deterministic, testable, frontend-independent",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "calibrate": "npx --yes tsx scripts/calibrate.ts",
    "check:authoritative-ball": "npx --yes tsx scripts/check-authoritative-ball.ts",
    "diagnose:offense": "npx --yes tsx scripts/diagnose-offensive-funnel.ts",
    "calibrate:quick": "npx --yes tsx scripts/calibrate.ts --matches 10 --tick 5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "coverage"
  },
  "keywords": [
    "football",
    "simulation",
    "match-engine",
    "sports-ai"
  ],
  "license": "MIT",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mariani5472/engine_futebol.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/Mariani5472/engine_futebol/issues"
  },
  "homepage": "https://github.com/Mariani5472/engine_futebol#readme"
}
